{
  "expo": {
    "name": "RodadaMoto",
    "slug": "rodadamoto",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rodadamoto",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0D0F11"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rodadamoto.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F11"
      },
      "package": "com.rodadamoto.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RodadaMoto usa tu ubicación para situar en el mapa las incidencias que reportas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
